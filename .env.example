# ========================================
# Database Configuration (PostgreSQL)
# ========================================

# REQUIRED: PostgreSQL database user
DB_USER=postgres

# REQUIRED: PostgreSQL database password
# IMPORTANTE: Cambia esto por una contraseña segura en producción
DB_PASSWORD=your_secure_password_here

# REQUIRED: PostgreSQL database name
DB_NAME=own_assistant

# Database host
# Use 'host.docker.internal' to connect to PostgreSQL running on the host (from Docker)
# Use 'localhost' only if running the binary directly (without Docker)
DB_HOST=host.docker.internal

# Database port
DB_PORT=5432

# SSL mode (disable for local dev, require for production)
# Opciones: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=disable

# ========================================
# Server Configuration
# ========================================

# Port where the server will listen
SERVER_PORT=1323

# ========================================
# Application Environment
# ========================================

# Environment mode: development, staging, production
ENV=development
